# npm run setup maakt .env aan en vervangt de geheimen door willekeurige waarden.
# HTTP-adres en poort waarop de website en registratie-API luisteren.
HOST=0.0.0.0
PORT=3001
# Verbinding met PostgreSQL; de lokale cluster gebruikt een aparte poort.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=homestation
DB_USER=homestation
DB_PASSWORD=replace_me
# Deze code is nodig om een nieuw station te registreren.
CLASS_CODE=replace_me

# De Node-server abonneert zich via deze broker; dit zijn geen stationssleutels.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Vul het LAN-IP van je computer in om ESP32’s toegang te geven tot de Docker-broker.
MQTT_BIND_ADDRESS=127.0.0.1
# De beveiligde publieke broker luistert uitsluitend op TLS-poort 8883.
MQTT_TLS_BIND_ADDRESS=0.0.0.0

# Zet op true bij gebruik achter een HTTPS-proxy voor beveiligde accountcookies.
COOKIE_SECURE=false

# Een aparte beheerlogin; admin:setup genereert het wachtwoord voor een bestaande installatie.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
