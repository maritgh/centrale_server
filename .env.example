# Create this file with `npm run setup`. Do not commit the generated .env.
DB_NAME=homestation
DB_USER=homestation
DB_PASSWORD=replace_me
CLASS_CODE=replace_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SECURE=false

# Host-side port bindings. Keep MQTT bound to localhost unless your LAN needs it.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3001
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883
