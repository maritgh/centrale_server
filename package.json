{
  "name": "home-station-network",
  "version": "1.0.0",
  "private": true,
  "description": "Home Station website and PostgreSQL weather API",
  "scripts": {
    "setup": "node scripts/setup.js",
    "admin:setup": "node scripts/admin-setup.js",
    "admin:start": "npm run admin:setup && npm start",
    "start": "node node.js",
    "db:start": "node scripts/local-db.js start",
    "db:stop": "node scripts/local-db.js stop",
    "db:setup": "node scripts/database.js",
    "test": "node --test",
    "test:db": "RUN_DB_TESTS=1 node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "mqtt": "^5.16.1",
    "pg": "^8.16.0"
  }
}
