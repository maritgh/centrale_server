# Vervang server_name door het IP-adres of domein van jouw server.
# Nginx stuurt website- en API-verzoeken door naar Node; MQTT gebruikt de eigen brokerpoort.
server {
    listen 80;
    server_name 145.24.237.237;

    # Stuur alle HTTP-paden door, zodat statische pagina’s en API-routes dezelfde host gebruiken.
    location / {
        proxy_pass http://127.0.0.1:3001;
        # Geef de oorspronkelijke host, client-IP en het protocol door aan de toepassing.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
