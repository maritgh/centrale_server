# Beheer de PostgreSQL-cluster in .local/postgres via het bestaande Node-script.
[Unit]
Description=Home Station local PostgreSQL database
After=network.target

[Service]
# Het script stopt na het starten; PostgreSQL blijft als achtergrondproces draaien.
Type=oneshot
RemainAfterExit=yes
# Pas deze gebruiker en de projectpaden aan voor de doelserver.
User=msnijder
WorkingDirectory=/home/msnijder/centrale_server
ExecStart=/usr/bin/node /home/msnijder/centrale_server/scripts/local-db.js start
# Bij stoppen van de service sluit het script PostgreSQL netjes af.
ExecStop=/usr/bin/node /home/msnijder/centrale_server/scripts/local-db.js stop

[Install]
WantedBy=multi-user.target
